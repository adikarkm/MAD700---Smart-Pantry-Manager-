<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.smartpantry.manager">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_pantry"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_pantry"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantryManager">
        
        <activity
            android:name=".activity.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.AddEditIngredientActivity"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name=".activity.RecipeDetailActivity"
            android:parentActivityName=".activity.MainActivity" />
            
    </application>

</manifest>
